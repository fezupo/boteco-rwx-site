---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredLive } from '../data/lives';
---

<BaseLayout title="Lives" description="Lives e rodadas do Boteco RWX.">
  <section class="page-hero section-pad">
    <div class="container">
      <span class="eyebrow">ARQUIVO DO BOTECO</span>
      <h1>Lives</h1>
      <p>Cada rodada ganha seu lugar sem obrigar você a cavar o canal inteiro.</p>
    </div>
  </section>

  <section class="section-pad section-dark">
    <div class="container">
      <SectionHeading eyebrow="EM DESTAQUE" title={`LIVE ${String(featuredLive.number).padStart(2, '0')}: ${featuredLive.title}`} text={featuredLive.description} />
      <div class="empty-panel">
        <strong>Arquivo em montagem</strong>
        <p>As rodadas anteriores serão organizadas aqui com contexto, tema e acesso direto quando os links oficiais forem cadastrados.</p>
      </div>
    </div>
  </section>
</BaseLayout>
