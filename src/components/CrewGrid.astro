---
import { crew } from '../data/crew';
---

<div class="crew-grid">
  {crew.map((person) => (
    <article class="crew-card">
      <div class="crew-avatar" aria-hidden="true">{person.initials}</div>
      <div>
        <h3>{person.name}</h3>
        <p>{person.role}</p>
      </div>
    </article>
  ))}
</div>
