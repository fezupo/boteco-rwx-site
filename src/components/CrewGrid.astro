---
import { crew } from '../data/crew';
import { withBase } from '../utils/paths';

const avatarByName = {
  Felipe: '/assets/avatar-felipe.webp',
  Will: '/assets/avatar-will.webp',
  KV: '/assets/avatar-kv.webp',
} as const;
---

<div class="crew-grid">
  {crew.map((person) => (
    <article class="crew-card">
      <div class="crew-avatar crew-avatar-image">
        <img
          src={withBase(avatarByName[person.name])}
          alt={`${person.name}, integrante do Boteco RWX`}
          width="160"
          height="160"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <h3>{person.name}</h3>
        <p>{person.role}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .crew-avatar.crew-avatar-image {
    overflow: hidden;
    padding: 0;
    background: #0b090b;
    box-shadow: 0 0 0 1px rgba(43, 199, 255, .08), 0 10px 30px rgba(0, 0, 0, .28);
  }

  .crew-avatar-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .crew-card:hover .crew-avatar-image {
    border-color: rgba(43, 199, 255, .48);
    box-shadow: 0 0 22px rgba(43, 199, 255, .14), 0 12px 34px rgba(0, 0, 0, .34);
  }
</style>
