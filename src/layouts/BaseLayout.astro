---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/boteco-background.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Boteco RWX',
  description = 'Games, anime, tokusatsu, música e conversa sem frescura.',
  noindex = false,
} = Astro.props;

const pageTitle = title === 'Boteco RWX' ? title : `${title} | Boteco RWX`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09070a" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Boteco RWX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/boteco-rwx-background.webp" as="image" fetchpriority="high" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="site-shell">
      <Header />
      <main id="conteudo">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
